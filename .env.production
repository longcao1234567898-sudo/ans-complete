# ==========================================================
#  BIẾN CHO BẢN DỰNG CHÍNH THỨC (npm run build)
# ==========================================================
# Vite tự đọc tệp này khi dựng bản production. Nhờ vậy Netlify tự dựng từ
# GitHub hay bạn kéo tay thư mục dist lên đều ra kết quả giống nhau.
#
# ⚠️ CẢ 4 GIÁ TRỊ NÀY ĐỀU CÔNG KHAI THEO THIẾT KẾ.
#    Vite nhúng thẳng mọi biến VITE_* vào tệp JavaScript tải về máy người
#    dùng — ai mở F12 cũng đọc được. TUYỆT ĐỐI không đặt khoá bí mật ở đây.
#    Khoá AI, khoá mã hoá, mật khẩu database -> đặt trên Render.
# ==========================================================

VITE_API_URL=https://hop-thu-so-v2.onrender.com

# Turnstile SITE key — cặp với TURNSTILE_SECRET_KEY trên Render.
# ⚠️ PHẢI cùng một tài khoản Cloudflare với khoá bí mật. Lệch nhau thì người
#    dân tick CAPTCHA thấy xanh nhưng máy chủ luôn báo sai -> không ai gửi
#    được ý kiến, mà cũng không hiện lỗi gì rõ ràng.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEAEbOrfoByk2Efy

# Cloudinary — tải ảnh kiểu không ký (unsigned). Cả hai đều công khai.
# ⚠️ KHÔNG đặt API secret của Cloudinary ở đây.
VITE_CLOUDINARY_CLOUD_NAME=l5qxyc83
VITE_CLOUDINARY_PRESET=hop-thu-an-ninh-so
