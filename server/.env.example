# ================= CẤU HÌNH MINI-BACKEND =================
# Sao chép file này thành ".env" rồi điền giá trị

# Cổng chạy server (Render sẽ tự cấp PORT, local dùng 4000)
PORT=4000

# ----- Kết nối MySQL -----
# Local XAMPP: host=localhost, user=root, password để trống
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hop_thu_an_ninh_so

# Khi dùng MySQL cloud (Aiven, PlanetScale...) yêu cầu SSL.
# ⚠️ DB_SSL=true nay VẪN XÁC THỰC chứng chỉ (chống man-in-the-middle).
#    Nhà cung cấp dùng CA riêng -> phải nạp CA, nếu không sẽ KHÔNG kết nối được.
#   DB_SSL_CA=/duong/dan/ca.pem      (đường dẫn file CA tải từ nhà cung cấp)
#   DB_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n..."  (dán thẳng nội dung PEM)
# DB_SSL_CA=
# DB_SSL_CA_PEM=
# DB_SSL=

# ----- AI (key nằm Ở ĐÂY, phía máy chủ — trình duyệt không bao giờ thấy) -----
GEMINI_API_KEY=
# Tuỳ chọn — đổi model mà không cần sửa mã nguồn. Trống = dùng mặc định trong code.
GEMINI_MODEL=
GEMINI_CHAT_MODEL=

# ----- CORS: các địa chỉ frontend được phép gọi API (phân cách bằng dấu phẩy) -----
# localhost:3000/4173/5173 luôn được phép sẵn cho môi trường dev
CORS_ORIGIN=

# ----- Kho ảnh Cloudinary (tuỳ chọn nhưng NÊN đặt) -----
# Phải KHỚP với VITE_CLOUDINARY_CLOUD_NAME bên frontend.
# Để trống: máy chủ vẫn chặn link ảnh từ miền lạ, nhưng KHÔNG phân biệt được
# kho ảnh của đơn vị với kho Cloudinary của người khác -> kẻ xấu tự tạo tài
# khoản Cloudinary rồi gửi link ảnh của họ vào hồ sơ vẫn lọt qua.
CLOUDINARY_CLOUD_NAME=

# ----- CAPTCHA chống bot (tuỳ chọn) -----
# Cloudflare Turnstile, miễn phí. Lấy khoá: dash.cloudflare.com -> Turnstile -> Add site
# Trống = bỏ qua kiểm tra CAPTCHA.
TURNSTILE_SECRET_KEY=

# ----- Gửi email OTP — chọn 1 trong 3 cách, để trống hết = chế độ demo (trả mã ra log) -----
# Cách 1 — Resend (KHUYÊN DÙNG, gửi qua HTTPS nên không bị Render/Netlify chặn cổng SMTP):
#   đăng ký resend.com, free 3.000 email/tháng
# RESEND_API_KEY=
# MAIL_FROM=onboarding@resend.dev
#
# Cách 2 — Brevo (gửi tới bất kỳ ai, không cần tên miền riêng):
# BREVO_API_KEY=
#
# Cách 3 — Gmail SMTP (hay bị timeout trên Render, chỉ nên dùng ở local):
# MAIL_USER=
# MAIL_PASS=

# ==========================================================
# BA KHOÁ BẮT BUỘC — THIẾU LÀ HỆ THỐNG KHÔNG CHẠY (cố ý như vậy)
# Sinh từng khoá bằng:  openssl rand -hex 32
# ==========================================================

# BẮT BUỘC. Ký vé đăng nhập của cán bộ + vé xác thực OTP của người dân.
# Tối thiểu 32 ký tự, nếu không server TỪ CHỐI KHỞI ĐỘNG.
# KHÔNG còn giá trị mặc định: bản cũ fallback về một chuỗi nằm sẵn trong repo
# GitHub -> ai đọc mã nguồn cũng tự ký được token admin.
JWT_SECRET=

# BẮT BUỘC. Mã hoá AES-256-GCM họ tên / SĐT / email người tố giác.
# Đúng 64 ký tự hex. Tạo riêng bằng: node scripts-tao-khoa-ma-hoa.js
# ⚠️ ĐỔI KHOÁ = MẤT TOÀN BỘ danh tính đã mã hoá. Sao lưu cẩn thận.
# Thiếu khoá -> hệ thống TỪ CHỐI nhận ý kiến có danh tính (tố giác ẩn danh
# vẫn hoạt động bình thường).
ENCRYPTION_KEY=

# BẮT BUỘC. Pepper cho các hàm băm định danh (SĐT, email, IP).
# Tối thiểu 32 ký tự. Nằm Ở ĐÂY, KHÔNG nằm trong database -> lộ database vẫn
# không dò ngược ra số điện thoại được.
# Đổi pepper chỉ làm mất tối đa 24 giờ lịch sử chống spam, không hỏng dữ liệu.
HASH_PEPPER=

NODE_ENV=development
